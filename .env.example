# npm 包版本。latest 仅在无缓存重建时重新解析。
DSH_VERSION=latest

# Web UI 对外监听配置。
DSH_BIND_ADDRESS=0.0.0.0
DSH_PORT=3080
DSH_TRUSTED_HOSTS=nas.example,192.0.2.10

# 允许 trusted-host 通过 Web UI 管理设置、凭据和模型探测；设为 0 可恢复仅 loopback 限制。
DSH_ALLOW_REMOTE_SETTINGS=1

TZ=Asia/Shanghai

# 也可以启动后在 Web UI 的“设置 -> 模型”中保存凭据。
# DEEPSEEK_API_KEY=your-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选代理。Node 24 会通过 NODE_USE_ENV_PROXY 使用这些变量。
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=127.0.0.1,localhost
