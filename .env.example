# dsh-container 安装的 DSH npm 包版本。latest 仅在无缓存重建时重新解析。
DSH_CONTAINER_DSH_VERSION=latest
# Compose 构建和运行使用的镜像仓库名。
DSH_CONTAINER_IMAGE=dsh-container

# dsh-container 对外监听及 DSH trusted-host 配置。默认仅本机访问；局域网部署请参阅 docs/guide.md。
DSH_CONTAINER_BIND_ADDRESS=127.0.0.1
DSH_CONTAINER_PORT=3080
DSH_CONTAINER_TRUSTED_HOSTS=localhost,127.0.0.1

# 可选单管理员共享密钥。启用后，页面、静态资源、API 和 WebSocket 均需先登录。
# 密钥会保留在容器和 Agent 环境中；不要在可疑工作区或不可信任务中使用敏感密钥。
# DSH_CONTAINER_KEY=replace-with-a-private-key

# 容器内部端口通常无需修改。
# DSH_CONTAINER_RELAY_PORT=3080
# DSH_CONTAINER_INTERNAL_PORT=3081

TZ=Asia/Shanghai

# 也可以启动后在 Web UI 的“设置 -> 模型”中保存凭据。
# DEEPSEEK_API_KEY=your-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选代理。Node 24 会通过 NODE_USE_ENV_PROXY 使用这些变量。
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=127.0.0.1,localhost
